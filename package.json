    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "printf 'EXPO_PUBLIC_API_URL=https://quickmartcorebackend.onrender.com/api/v1\\nEXPO_PUBLIC_USE_MOCK=false\\n' > .env.local && expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease && rm -f ../.env.local",
    "build:apk:copy": "mkdir -p dist && cp android/app/build/outputs/apk/release/app-release.apk dist/quickmart-customer-preview.apk",
    "build:apk:preview": "npm run build:apk && npm run build:apk:copy",
    "build:apk:release": "printf 'EXPO_PUBLIC_API_URL=https://quickmartcorebackend.onrender.com/api/v1\\nEXPO_PUBLIC_USE_MOCK=false\\n' > .env.local && cd android && ./gradlew assembleRelease && rm -f ../.env.local && npm run build:apk:copy"
  },
  "private": true
}
