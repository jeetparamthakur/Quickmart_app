# Local dev (same Wi-Fi): http://192.168.x.x:3000/api/v1
# Production / APK testing: https://quickmartcorebackend.onrender.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_USE_MOCK=false
# Maps: MapLibre + OpenStreetMap after native build (free, no API key).
# Rebuild after install: npx expo prebuild --clean && npx expo run:android
# Optional custom MapLibre style URL:
# EXPO_PUBLIC_MAP_STYLE_URL=
# Optional Google Maps (requires native rebuild):
# EXPO_PUBLIC_USE_GOOGLE_MAPS=true
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional customer support contact (Help & Support screen):
# EXPO_PUBLIC_SUPPORT_EMAIL=support@quickmart.app
# EXPO_PUBLIC_SUPPORT_PHONE=919876543210
# localhost is rewritten on device/emulator to your Metro machine IP (or 10.0.2.2 on Android).

